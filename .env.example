# Copy this file to `.env` and fill in your values.
# Never commit `.env` to git — it contains your API keys.

# ─── Required ────────────────────────────────────────────────────────────
# Get from https://console.cloud.google.com → enable YouTube Data API v3
YOUTUBE_API_KEY=AIzaSy___your_key_here___

# ─── Optional ────────────────────────────────────────────────────────────
# Comma-separated fallback keys. The scraper rotates to these when the
# primary key hits its daily quota.
# YOUTUBE_API_KEY_FALLBACKS=AIzaSy___fallback1___,AIzaSy___fallback2___

# Override default daily quota (10,000). Set higher only after Google has
# approved a quota increase for your project.
# YOUTUBE_DAILY_QUOTA=1000000
